# ResinDB Pro local demonstration environment
#
# Vite exposes every VITE_* variable to the browser bundle. Use only a
# disposable, restricted development key here. Production deployments should
# call Gemini through an authenticated server-side API or gateway.

VITE_GEMINI_API_KEY=
VITE_GEMINI_FAST_MODEL=gemini-3.5-flash
VITE_GEMINI_REASONING_MODEL=gemini-3.1-pro-preview

# Storage adapter: indexeddb (default) or remote_api.
VITE_DATABASE_ADAPTER_TYPE=indexeddb

# Used only when VITE_DATABASE_ADAPTER_TYPE=remote_api.
VITE_REMOTE_API_BASE_URL=/api

# Optional read/export fallback. Mutating remote operations never fall back to
# IndexedDB because that would create divergent server and browser databases.
VITE_REMOTE_READ_FALLBACK=false
