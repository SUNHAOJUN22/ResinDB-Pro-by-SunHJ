rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function userDocument(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserDocument() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserDocument()
        && userDocument(request.auth.uid).data.role == 'admin';
    }

    function isEditor() {
      return hasUserDocument()
        && (
          userDocument(request.auth.uid).data.role == 'admin'
          || userDocument(request.auth.uid).data.role == 'editor'
        );
    }

    function hasValidProductShape(data) {
      return data.keys().hasAll([
          'gradeName',
          'properties',
          'ownerId',
          'createdAt',
          'updatedAt'
        ])
        && data.gradeName is string
        && data.gradeName.size() > 0
        && data.gradeName.size() <= 200
        && data.properties is map
        && data.ownerId is string
        && (!('manufacturerId' in data)
          || (data.manufacturerId is string && data.manufacturerId.size() <= 200))
        && (!('manufacturer' in data)
          || (data.manufacturer is string && data.manufacturer.size() <= 200))
        && (!('categoryIds' in data)
          || (data.categoryIds is list && data.categoryIds.size() <= 50));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 200
        && data.role is string
        && (
          data.role == 'admin'
          || data.role == 'editor'
          || data.role == 'viewer'
        );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isAdmin();

      // Self-service account creation is intentionally viewer-only. Privileged
      // roles must be provisioned by an existing administrator.
      allow create: if (
          isSignedIn()
          && request.auth.uid == userId
          && isValidUser(incoming())
          && incoming().role == 'viewer'
          && incoming().createdAt is number
        ) || (
          isAdmin()
          && isValidUser(incoming())
          && incoming().createdAt is number
        );

      allow update: if isAdmin()
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email']);

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if isSignedIn();

      allow create: if isEditor()
        && isValidId(productId)
        && hasValidProductShape(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt is number
        && incoming().updatedAt is number;

      allow update: if isEditor()
        && isValidId(productId)
        && hasValidProductShape(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt is number;

      allow delete: if isAdmin()
        || (
          isEditor()
          && existing().ownerId == request.auth.uid
        );
    }
  }
}
